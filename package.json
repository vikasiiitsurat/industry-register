{
  "name": "industry-register", "private": true, "type": "module",
  "workspaces": ["client", "server", "shared"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "fixture": "node scripts/create-fixture.mjs",
    "samples:inspect": "node scripts/inspect-samples.mjs"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
