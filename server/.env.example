HOST=127.0.0.1
PORT=3001
# Optional exact production frontend origin, such as https://your-project.vercel.app.
# Current Vercel deployment, branch, and production origins also use Vercel system variables.
CLIENT_ORIGIN=http://127.0.0.1:5173
# Optional local LibreOffice executable. Leave blank for DOCX/XLSX.
LIBREOFFICE_PATH=
# At most 4 MB on every environment to leave room below Vercel's 4.5 MB payload limit.
MAX_FILE_MB=4
CONVERSION_TIMEOUT_MS=45000
FILE_TIMEOUT_MS=90000
# Optional server-side XLSX template with the exact 34 headers. Leave blank for generated output.
EXCEL_TEMPLATE_PATH=
