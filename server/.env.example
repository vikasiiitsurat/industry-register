DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/industry_register
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
# Optional. Windows example: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=
MAX_FILE_MB=10
MAX_BATCH_FILES=10
PROCESS_CONCURRENCY=2
CONVERSION_TIMEOUT_MS=45000
FILE_TIMEOUT_MS=90000
BATCH_TIMEOUT_MS=300000
# Optional absolute path to the original .xlsx template, once provided.
EXCEL_TEMPLATE_PATH=
